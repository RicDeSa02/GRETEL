{
    // Debug targets for the current experiment tree. Every "args" entry is a
    // config path relative to the repository root; swap it for any other
    // config under lab/config/ to debug that combination instead.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Experiment: ASD / DCE + LocalSearch (fold 0)",
            "type": "python",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["lab/config/generate_minimize/asd/dce/dce-lcls/generate_minimize0.jsonc", "1"]
        },
        {
            "name": "Experiment: Synthie / DCE + LocalSearch (fold 0)",
            "type": "python",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["lab/config/generate_minimize/synthie/dce/dce-lcls/generate_minimize0.jsonc", "1"]
        },
        {
            "name": "Experiment: config of the open file",
            "type": "python",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["${relativeFile}", "1"]
        },
        {
            "name": "Queue: run the revision batch (1 worker)",
            "type": "python",
            "request": "launch",
            "program": "scripts/run_revision_queue.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--workers", "1"]
        },
        {
            "name": "Smoke test: ASD, non-trainable variants",
            "type": "python",
            "request": "launch",
            "program": "tests/regression_smoke.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": ["--datasets", "asd", "--timeout", "240"]
        },
        {
            "name": "Checks: config references + import smoke",
            "type": "python",
            "request": "launch",
            "program": "tools/check_config_refs.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            // "cwd": "${workspaceFolder}",
            // "env": { "PYTHONPATH": "${workspaceFolder}" },
            "args": ["XPlore_config\\ORACLE\\TCR\\TCR-50000-16-0.5_GAT_XPlore.jsonc", "1"]
        },
        {
            "name": "Python: Main File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            // "cwd": "${workspaceFolder}",
            // "env": { "PYTHONPATH": "${workspaceFolder}" },
            "args": ["${input:configFile}", "${input:runMode}"]
        },
        {
            "name": "RSGG_ASD",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["config/RSGG_ASD.json", "1"],
        },
        {
            "name": "TWITTER_TEST",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["config/new_datasets/TWITTER_DCE.json", "1"],
        }             
    ],
    "inputs": [
    {
      "id": "configFile",
      "type": "promptString",
      "description": "Path to config file",
      "default": "XPlore_config\\ORACLE\\IMDB\\IMDB_GAT_XPlore.jsonc"
    },
    {
      "id": "runMode",
      "type": "promptString",
      "description": "Run mode (e.g. 1)",
      "default": "1"
    }
  ]
}